# =============================================================
# Ambulance Finder - Backend Environment Variables (Example)
# =============================================================
# SETUP INSTRUCTIONS (Teammates):
#   1. এই file টি copy করো:  cp .env.example .env
#   2. নিচের values গুলো তোমার local setup অনুযায়ী বদলাও
#   3. .env file কখনো GitHub এ push করবে না (already .gitignored)
# =============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ambulance_finder

# JWT Configuration
# Production এ অবশ্যই strong random string দিতে হবে
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production

# Token Expiry
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Frontend URL (CORS whitelist)
CLIENT_URL=http://localhost:3000
