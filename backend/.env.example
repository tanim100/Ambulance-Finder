# =============================================================
# Ambulance Finder - Backend Environment Configuration Template
# =============================================================
# INSTRUCTIONS FOR TEAM MEMBERS:
#   1. Copy this file to create your local .env:
#      copy .env.example .env (Windows) or cp .env.example .env (Linux/Mac)
#   2. Update DB_PASSWORD with your local MySQL root password (e.g., 12345, root, or leave blank if no password)
#   3. .env is git-ignored and should NEVER be committed to Git.
# =============================================================

PORT=5000
NODE_ENV=development

# MySQL Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ambulance_finder

# JWT Authentication
JWT_SECRET=ambulance_finder_jwt_secret_dev_2024
JWT_REFRESH_SECRET=ambulance_finder_refresh_secret_dev_2024
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Frontend CORS URL
CLIENT_URL=http://localhost:3000
