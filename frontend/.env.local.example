# =============================================================
# Ambulance Finder - Frontend Environment Configuration Template
# =============================================================
# INSTRUCTIONS FOR TEAM MEMBERS:
#   1. Copy this file to create your local .env.local:
#      copy .env.local.example .env.local (Windows) or cp .env.local.example .env.local (Linux/Mac)
#   2. .env.local is git-ignored and keeps your local dev URLs.
# =============================================================

# Backend Express REST API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Real-time Socket.io Server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# =============================================================
# Firebase Live Location Streaming Configuration
# (Firebase Console -> Project Settings -> General -> Your Apps)
# =============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
