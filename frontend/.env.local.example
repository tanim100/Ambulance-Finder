# =============================================================
# Ambulance Finder - Frontend Environment Variables (Example)
# =============================================================
# SETUP INSTRUCTIONS (Teammates):
#   1. এই file টি copy করো:  cp .env.local.example .env.local
#   2. নিচের values গুলো তোমার local setup অনুযায়ী বদলাও
#   3. .env.local file কখনো GitHub এ push করবে না (already .gitignored)
# =============================================================

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Socket.io Server URL (same as backend)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
